[importlinter]
root_package = apps

[importlinter:contract:core-isolation]
name = core-isolation
type = forbidden
source_modules =
    apps.core
forbidden_modules =
    apps.identity
    apps.ledger
    apps.payments
    apps.offers
    apps.matching
    apps.loans
    apps.investments
    apps.budgets
    apps.reports
    apps.notifications

[importlinter:contract:ledger-no-identity-models]
name = ledger-no-identity-models
type = forbidden
allow_indirect_imports = True
source_modules =
    apps.ledger
forbidden_modules =
    apps.identity.models
    apps.identity.views
    apps.identity.serializers
    apps.identity.admin
    apps.identity.urls

