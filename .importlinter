[importlinter]
root_package = apps

[importlinter:contract:core-isolation]
name = core-isolation
type = forbidden
source_modules =
    apps.core
forbidden_modules =
    apps.identity
    apps.ledger
    apps.payments
    apps.offers
    apps.matching
    apps.loans
    apps.investments
    apps.budgets
    apps.reports
    apps.notifications

[importlinter:contract:ledger-no-identity-models]
name = ledger-no-identity-models
type = forbidden
allow_indirect_imports = True
source_modules =
    apps.ledger
forbidden_modules =
    apps.identity.models
    apps.identity.views
    apps.identity.serializers
    apps.identity.admin
    apps.identity.urls

[importlinter:contract:identity-no-ledger]
name = identity-no-ledger
type = forbidden
allow_indirect_imports = True
source_modules =
    apps.identity
forbidden_modules =
    apps.ledger
    apps.payments
    apps.offers
    apps.matching
    apps.loans
    apps.investments
    apps.budgets
    apps.reports
    apps.notifications

[importlinter:contract:offers-no-identity-models]
name = offers-no-identity-models
type = forbidden
allow_indirect_imports = True
source_modules =
    apps.offers
forbidden_modules =
    apps.identity.models
    apps.identity.views
    apps.identity.serializers
    apps.identity.admin
    apps.identity.urls

[importlinter:contract:offers-no-matching]
name = offers-no-matching
type = forbidden
allow_indirect_imports = True
source_modules =
    apps.offers
forbidden_modules =
    apps.matching

[importlinter:contract:matching-no-offers-models]
name = matching-no-offers-models
type = forbidden
allow_indirect_imports = True
source_modules =
    apps.matching
forbidden_modules =
    apps.offers.models
    apps.offers.views
    apps.offers.serializers
    apps.offers.admin
    apps.offers.urls
    apps.offers.services