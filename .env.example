# Django settings
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL 16)
DATABASE_URL=postgres://presto:presto@localhost:5432/presto
# Alternatively, individual variables:
# POSTGRES_DB=presto
# POSTGRES_USER=presto
# POSTGRES_PASSWORD=presto
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0
# Celery broker: defaults to REDIS_URL when not set
CELERY_BROKER_URL=redis://localhost:6379/0

# Simple JWT
SIGNING_KEY=jwt-change-me

# Email (SMTP de las notificaciones)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@presto.local

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Sentry (optional)
SENTRY_DSN=https://o0.ingest.sentry.io/0

# Environment
DJANGO_ENV=production