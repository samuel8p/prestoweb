# Django settings
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL 16)
DATABASE_URL=postgres://presto:presto@localhost:5432/presto
# Alternatively, individual variables:
# POSTGRES_DB=presto
# POSTGRES_USER=presto
# POSTGRES_PASSWORD=presto
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# SSL de la base: `require` para las bases administradas de las plataformas.
# Sin definir, la conexión no pide SSL (comportamiento de siempre).
# DB_SSLMODE=require

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0
# Celery broker: defaults to REDIS_URL when not set
CELERY_BROKER_URL=redis://localhost:6379/0

# Modo demo: con DEMO_MODE=true la aplicación corre como demostración (el
# dinero es simulado y los avisos de las notificaciones salen por consola, en
# los logs del worker). Sin DEMO_MODE, el dinero simulado queda bloqueado por
# el system check ledger.E001.
# Este es el ejemplo de DESARROLLO: en producción va en false (ver
# .env.prod.example).
DEMO_MODE=true

# Depósitos y retiros simulados: con LEDGER_SIMULATED_DEPOSITS_ENABLED=true se
# puede mover dinero simulado. En producción tiene que quedar apagado (salvo
# en modo demo) y el system check ledger.E001 lo impide.
LEDGER_SIMULATED_DEPOSITS_ENABLED=true

# Email: en modo demo los avisos de las notificaciones salen por consola, en los
# logs del worker (`docker compose logs -f worker`). Definí EMAIL_HOST para usar
# un SMTP de verdad.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@presto.local

# CORS: los orígenes del front, separados por comas. La lista se lee en
# `CORS_ALLOWED_ORIGINS`; vacío significa que ningún origen puede llamar a la
# API y nunca se usa `*`.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Sentry (opcional): la variable queda documentada, pero hoy la aplicación no
# la lee (no está instalado sentry-sdk).
SENTRY_DSN=https://o0.ingest.sentry.io/0

# Environment
# En desarrollo el compose usa config.settings.local (este valor no lo lee el
# compose de desarrollo).
DJANGO_ENV=local